{
  "server": {
    "host": "0.0.0.0",
    "port": 9998
  },
  "parsers": [
    {
      "external-parser": {
        "_mime-include": [
          "application/x-jtd",
          "application/x-ichitaro-jtd",
          "application/jtd",
          "application/x-jtt",
          "application/x-ichitaro-jtt",
          "application/jtt",
          "application/x-jttc",
          "application/x-ichitaro-jttc",
          "application/jttc"
        ],
        "supportedTypes": [
          "application/x-jtd",
          "application/x-ichitaro-jtd",
          "application/jtd",
          "application/x-jtt",
          "application/x-ichitaro-jtt",
          "application/jtt",
          "application/x-jttc",
          "application/x-ichitaro-jttc",
          "application/jttc"
        ],
        "commandLine": [
          "/usr/local/bin/rjtd-wrapper.sh",
          "${INPUT_FILE}"
        ],
        "checkCommandLine": [
          "/usr/local/bin/rjtd",
          "--help"
        ],
        "checkErrorCodes": [
          126,
          127
        ],
        "contentSource": "stdout"
      }
    },
    {
      "default-parser": {}
    }
  ]
}
